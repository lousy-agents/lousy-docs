{
    "name": "lousy-docs",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "bash scripts/fetch-docs.sh",
        "build": "npm run prebuild && astro build && node scripts/minify-pagefind.mjs",
        "dev": "bash scripts/fetch-docs.sh && astro dev --host 0.0.0.0",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "lint:workflows": "actionlint",
        "lint:yaml": "yamllint .",
        "preview": "astro preview",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:dist": "npm run build && TEST_PREVIEW=true playwright test",
        "test:e2e:ui": "playwright test --ui",
        "fixture:docs-slugs": "node scripts/generate-docs-slugs.mjs"
    },
    "dependencies": {
        "@astrojs/react": "5.0.7",
        "@astrojs/sitemap": "3.7.4",
        "@lousy-agents/lint": "5.21.6",
        "antd": "6.6.3",
        "astro": "6.4.8",
        "astro-pagefind": "1.8.6",
        "pino": "10.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "yaml": "2.9.1",
        "zod": "4.6.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@lousy-agents/mcp": "5.21.6",
        "@modelcontextprotocol/server-sequential-thinking": "2026.8.31",
        "@playwright/mcp": "0.0.80",
        "@playwright/test": "1.63.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/chance": "1.1.8",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@upstash/context7-mcp": "4.1.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/ui": "5.0.0",
        "chance": "1.1.13",
        "esbuild": "0.28.2",
        "happy-dom": "20.14.5",
        "jsdom": "30.0.1",
        "msw": "2.15.0",
        "typescript": "7.0.2",
        "vitest": "5.0.0",
        "whatwg-fetch": "3.6.20",
        "wrangler": "4.131.1"
    }
}
