{
    "name": "lousy-docs",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "bash scripts/fetch-docs.sh",
        "build": "npm run prebuild && astro build && node scripts/minify-pagefind.mjs",
        "dev": "bash scripts/fetch-docs.sh && astro dev --host 0.0.0.0",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "lint:workflows": "actionlint",
        "lint:yaml": "yamllint .",
        "preview": "astro preview",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:dist": "npm run build && TEST_PREVIEW=true playwright test",
        "test:e2e:ui": "playwright test --ui",
        "fixture:docs-slugs": "node scripts/generate-docs-slugs.mjs"
    },
    "dependencies": {
        "@astrojs/react": "5.0.7",
        "@astrojs/sitemap": "3.7.6",
        "@lousy-agents/lint": "5.23.10",
        "antd": "6.6.8",
        "astro": "6.4.8",
        "astro-pagefind": "1.8.6",
        "pino": "10.4.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "yaml": "2.9.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@lousy-agents/mcp": "5.23.10",
        "@modelcontextprotocol/server-sequential-thinking": "2026.8.31",
        "@playwright/mcp": "0.0.86",
        "@playwright/test": "1.65.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/chance": "1.1.8",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@upstash/context7-mcp": "4.7.3",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/ui": "5.1.1",
        "chance": "1.1.13",
        "esbuild": "0.28.2",
        "happy-dom": "21.0.4",
        "jsdom": "30.1.3",
        "msw": "3.0.7",
        "typescript": "7.0.2",
        "vitest": "5.1.1",
        "whatwg-fetch": "3.6.20",
        "wrangler": "4.166.0"
    }
}
